# Path to the OAuth 2.0 client secret JSON downloaded from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Download JSON)
GOOGLE_OAUTH_CREDENTIALS=credentials.json

# Where the script caches the OAuth token after first login (auto-created)
TOKEN_PATH=token.json

# Google Drive folder name where CSVs are uploaded (created if absent)
EXPORT_FOLDER_NAME=Google Tasks Exports
